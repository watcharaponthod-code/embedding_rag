# Development Dockerfile for hot-reloading
FROM node:20-bookworm-slim

# Install Python and required system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    gcc \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (including devDependencies for development)
RUN npm install

# Install Python dependencies
COPY requirements.txt ./
RUN pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu --break-system-packages && \
    pip3 install transformers pymupdf python-pptx --break-system-packages --no-cache-dir

# Copy source code (will be overridden by volume mount in docker-compose)
COPY . .

# Create uploads directory
RUN mkdir -p /app/uploads && chmod 777 /app/uploads

# Expose ports
EXPOSE 5173 3001

# Set environment
ENV PYTHON_PATH=/usr/bin/python3
ENV NODE_ENV=development

# Default command (can be overridden in docker-compose)
CMD ["npm", "run", "dev:all"]
